<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="Pot"
    MinWidth="512"
    MinSize="512 256">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <PanelContainer
            Name="IngredientsPanel"
            Access="Public"
            MinSize="300 128"
            VerticalExpand="True"
            Margin="5 5">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ItemList
                Name="IngredientsList"
                Access="Public"
                Margin="5 5"
                VerticalExpand="True"
                HorizontalExpand="True"
                StyleClasses="transparentBackgroundItemList"
                SelectMode="Button"
                SizeFlagsStretchRatio="3"
                ItemSeparation="5"
                MinSize="100 128">
                <!-- Ingredients are added here by code -->
            </ItemList>
        </PanelContainer>
        <Button
            Name="EjectButton"
            Access="Public"
            Text="{Loc 'microwave-menu-eject-all-text'}"
            ToolTip="{Loc 'microwave-menu-eject-all-tooltip'}"
            StyleClasses="negative"
            MaxSize="280 120"
            HorizontalExpand="True"
            TextAlign="Center" Margin="10 10" />
    </BoxContainer>
</controls:FancyWindow>
